---@class resurrect.Session
---@field id integer|nil
---@field name string|nil - `<name>:<cwd>`
---@field files table[] - rows of the files table

---@class resurrect.DB
---@field db sqlite_db
---@field config table
---@field session resurrect.Session - the active session
---@field session_count integer
local class DB {
  --- opens (creating if needed) the sqlite db at config.db_path
  new(config) {
    local sqlite = require('sqlite')
    self.config = config
    -- per instance, in new(): a table as a class field would be shared by
    -- every instance
    self.session = { id = nil, name = nil, files = {} }
    self.session_count = 0
    self.db = sqlite({
      uri = config.db_path,
      opts = { foreign_keys = true },
      sessions = {
        id = true,
        created = { 'timestamp', default = sqlite.lib.strftime('%s', 'now') },
        name = { 'text', unique = true },
      },
      files = {
        id = true,
        path = 'text',
        session_id = { 'integer', reference = 'sessions.id', on_delete = 'cascade' },
        row = 'integer',
        col = 'integer',
      },
      -- the focused file per session. A table of its own: sqlite.lua can
      -- create new tables in an existing db, but can't add a column to one
      -- ("schema defined ~= db schema")
      last_file = {
        id = true,
        session_id = { 'integer', unique = true, reference = 'sessions.id', on_delete = 'cascade' },
        path = 'text',
      },
    })
    ---@diagnostic disable-next-line: missing-parameter
    self.db:open()
    self:migrate()
  }

  --- one row per file per session. Older versions could add a file twice, so
  --- drop the duplicates, then let a unique index (not part of the table's
  --- schema, so sqlite.lua doesn't mind) keep it that way
  migrate() {
    self.db:execute([[
      delete from files where id not in (select min(id) from files group by session_id, path)
    ]])
    self.db:execute('create unique index if not exists files_session_path on files (session_id, path)')
  }

  --- sessions for the cwd (names end in `:<cwd>`). Filtered here rather than
  --- w/ `name like '%:<cwd>'`, since `_` and `%` in a path are LIKE wildcards
  ---@return table[]
  cwd_sessions() {
    const rows = self.db:eval('select * from sessions')
    if type(rows) != 'table' { return {} } -- (eval returns a boolean for no rows)
    const suffix = ":{vim.fn.getcwd()}"
    return vim.iter(rows):filter((s) -> vim.endswith(s.name, suffix)):totable()
  }

  ---@return boolean
  has_sessions() {
    self.session_count = #self:cwd_sessions()
    return self.session_count > 0
  }

  --- makes `name` (default: 'default') the active session, creating it if
  --- it's new
  ---@return boolean created - false if it already existed (its files are loaded)
  new_session(name = 'default') {
    const session_name = "{name}:{vim.fn.getcwd()}"
    ---@diagnostic disable-next-line: missing-fields
    const existing = self.db:select('sessions', { where = { name = session_name } })[1]
    if existing {
      vim.notify('found existing session', vim.log.levels.DEBUG)
      self:activate(existing)
      return false
    }
    const success, id = self.db:insert('sessions', { name = session_name })
    if !success {
      error('could not add new session')
    }
    self.session = { id = id, name = session_name, files = {} }
    return true
  }

  --- the cwd's session called `name`, or nil
  find_session(name) {
    ---@diagnostic disable-next-line: missing-fields
    return self.db:select('sessions', { where = { name = "{name}:{vim.fn.getcwd()}" } })[1]
  }

  --- lets the user pick one of the cwd's sessions; cb(shortname, session)
  --- (not called if there are none, or the picker is cancelled)
  choose_session(cb) {
    const sessions = self:cwd_sessions()
    if #sessions == 0 { return }
    for _, s in ipairs(sessions) {
      s.files = self:get_files(s)
    }
    require('resurrect/ui').choose_session(sessions, (s) -> {
      if s { cb(require('resurrect/util').session_shortname(s.name), s) }
    })
  }

  --- picks a session (directly if there's only one, unless
  --- config.always_choose), makes it active, and calls cb(shortname, files)
  load_session(cb) {
    const sessions = self:cwd_sessions()
    if #sessions == 0 {
      vim.notify('no sessions', vim.log.levels.INFO)
      return
    }
    const load = (s) -> {
      self:activate(s)
      cb(require('resurrect/util').session_shortname(s.name), self.session.files)
    }
    if #sessions == 1 && !self.config.always_choose {
      load(sessions[1])
      return
    }
    self:choose_session((_, s) -> load(s))
  }

  --- makes a sessions row the active session, w/ its files
  activate(s) {
    self.session = { id = s.id, name = s.name, files = self:get_files(s) }
    if self.config.debug {
      vim.print(self.session.files)
    }
  }

  delete_session(id) {
    if !self.db:delete('sessions', { id = id }) {
      error('could not delete resurrect session')
    }
  }

  ---@return table[]
  get_files(session) {
    ---@diagnostic disable-next-line: missing-fields
    return self.db:select('files', { where = { session_id = session.id } })
  }

  --- adds a file to the active session (a no-op if it's already in it)
  add_file(path) {
    if path && path != '' {
      self.db:eval(
        'insert or ignore into files (path, session_id) values (?, ?)',
        { path, self.session.id }
      )
    }
  }

  --- remembers the active session's focused file
  set_last_file(path) {
    if self.session.last_file == path { return } -- (BufEnter fires a lot)
    self.session.last_file = path
    self.db:eval(
      'insert into last_file (session_id, path) values (?, ?) on conflict (session_id) do update set path = excluded.path',
      { self.session.id, path }
    )
  }

  --- the active session's last focused file, or nil
  ---@return string|nil
  last_file() {
    ---@diagnostic disable-next-line: missing-fields
    const row = self.db:select('last_file', { where = { session_id = self.session.id } })[1]
    return row && row.path
  }

  --- saves a file's cursor ({ path, row, col })
  update_file(update) {
    if update.path && update.path != '' {
      self.db:update('files', {
        where = { session_id = self.session.id, path = update.path },
        set = { row = update.row, col = update.col },
      })
    }
  }

  del_file(path) {
    self.db:delete('files', { path = path, session_id = self.session.id })
  }

  prune_session_files(dead_files) {
    -- TODO: config option to put dead files in quickfix
    vim.notify('pruning dead files', vim.log.levels.DEBUG)
    for _, file in ipairs(dead_files) {
      self:del_file(file.path)
    }
  }
}

return DB
